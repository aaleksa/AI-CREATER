PORT=4000
JWT_SECRET=change-me-in-production
# OpenAI (active)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Same id as in platform.openai.com → Images → Model (gpt-image-2.5-sunburst or gpt-image-2.5-flare)
OPENAI_MAX_INPUT_CHARS=100000
# Optional. When set, Voice uses OpenAI TTS and Visuals use OPENAI_IMAGE_MODEL. Otherwise Voice uses macOS say / silent audio.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:5173
# Email confirmation (resend.com). MAIL_FROM needs a domain verified in Resend;
# onboarding@resend.dev only delivers to your own Resend address.
RESEND_API_KEY=
MAIL_FROM=Auteur <hello@your-domain.com>
# auto (default): confirmation is required only when RESEND_API_KEY is set and MAIL_FROM is not @resend.dev.
# Otherwise new accounts get 400 credits at once, as before. on = always (without a key the link is printed
# in the API log — for local tests). off = never.
# EMAIL_VERIFICATION=auto
# Optional. Folder for the database and all files. On a host, point it at a persistent volume.
# DATA_DIR=/data
# Optional. Who may open the read-only Database page at /app/admin (unset = off). Register the account first, then list its email.
# ADMIN_EMAILS=you@example.com
# Stricter alternative: account ids (comma-separated). Open /app/account?id on the server to see yours.
# ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000
# Optional, local only. COMFYUI_URL set = photos are painted by your ComfyUI; not set = OpenAI.
# If ComfyUI is off or fails the app shows an error (nothing is sent to OpenAI) unless COMFYUI_FALLBACK=openai.
# Leave unset on a hosted server. Designed flyers with words, example / brand photos and edits always use OpenAI.
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_CHECKPOINT=your-model.safetensors
# COMFYUI_WORKFLOW=comfy/workflow.json      # API-format export; default: comfy/workflow.example.json
# COMFYUI_MAX_SIDE=1024                     # longest side; use 512–768 for SD 1.5 models
# COMFYUI_FALLBACK=openai                   # opt in: use OpenAI when ComfyUI fails (costs money)
# COMFYUI_KINDS=still,video                 # add poster to try it on flyers too
# COMFYUI_NEGATIVE=text, watermark, blurry
# COMFYUI_STEPS=25                          # fewer = faster (try 20); Lightning models: 4–6
# COMFYUI_CFG=7                             # Lightning models: 1.5–2
# COMFYUI_TIMEOUT_MS=300000
