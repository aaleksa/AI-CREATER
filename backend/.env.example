PORT=4000
JWT_SECRET=change-me-in-production
# OpenAI (active)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Same id as in platform.openai.com → Images → Model (gpt-image-2.5-sunburst or gpt-image-2.5-flare)
OPENAI_MAX_INPUT_CHARS=100000
# Optional. When set, Voice uses OpenAI TTS and Visuals use OPENAI_IMAGE_MODEL. Otherwise Voice uses macOS say / silent audio.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:5173
